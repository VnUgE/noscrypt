###############################################################################
# Set default behavior to automatically normalize line endings.
# LF in repo, native (CRLF on Windows) on checkout.
###############################################################################
* text=auto

###############################################################################
# Shell scripts and Linux-only files must always be LF, even on checkout
###############################################################################
*.sh       text eol=lf
Dockerfile text eol=lf
*.cmake    text eol=lf

###############################################################################
# Binary — never normalize
###############################################################################
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.tar      binary
*.gz       binary
*.tgz      binary
*.deb      binary
*.so       binary
*.dll      binary
*.exe      binary
*.pdb      binary
*.nupkg    binary
*.snk      binary
*.pfx      binary